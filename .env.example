# Copy to .env and fill in only what you need. Never commit .env.

# LLM provider: mock (default, offline, no key) | groq | openai_compat
LLM_PROVIDER=mock

# Used when LLM_PROVIDER is groq or openai_compat (any OpenAI-compatible endpoint)
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
# Check your provider's current model list if this id is rejected
LLM_MODEL=llama-3.3-70b-versatile
LLM_TIMEOUT_S=30
LLM_MAX_CONCURRENCY=2
LLM_CACHE_DIR=.cache/llm

# Matching thresholds (defaults shown; see docs/Architecture.md section 8)
DATE_WINDOW_EXACT_DAYS=3
DATE_WINDOW_FUZZY_DAYS=10
DATE_MISMATCH_MAX_DAYS=30
FUZZY_ACCEPT=0.75
REF_STRONG=0.90
PAIR_MARGIN=0.05
DUP_DATE_WINDOW_DAYS=3
FEE_MAX_MINOR=2500
SPLIT_MAX_PARTS=4
SPLIT_DATE_WINDOW_DAYS=7
SPLIT_TOLERANCE_MINOR=0
SPLIT_MAX_POOL=30
SPLIT_MIN_SIM=0.4
SPLIT_MAX_NODES=200000
SEVERITY_HIGH_MINOR=1000000
SEVERITY_MEDIUM_MINOR=100000
DEFAULT_CURRENCY=USD
DATE_DAYFIRST=false
LEDGER_SIGN_INVERTED=false
